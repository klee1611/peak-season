# Copy to .env for local runs. In GitHub Actions these come from repo variables/secrets.
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_NAME=gemma4:e2b-it-qat
# MODEL_API_KEY=            # only for a hosted OpenAI-compatible endpoint
SQLITE_PATH=.cache/peakseason.db

# SerpApi is optional; without a key, ingest runs on iNaturalist alone.
# SERPAPI_API_KEY=
SERPAPI_CACHE_HOURS=48
SERPAPI_RESERVE=20
SERPAPI_MAX_CALLS_PER_RUN=10

MAX_PHOTOS_PER_RUN=80
MAX_PHOTOS_PER_CELL=3
CLASSIFY_DEADLINE_MIN=90
WINDOW_DAYS=7
INAT_USER_AGENT="PeakSeason/0.1 (+https://github.com/<you>/peakseason; open-source hackathon)"

# Stretch goal (events)
# TICKETMASTER_API_KEY=
# EVENT_RADIUS_KM=15
