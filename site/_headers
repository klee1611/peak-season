# Cloudflare Pages headers. Data changes every ~12 h; let browsers recheck it after 5 minutes.
/data/*
  Cache-Control: public, max-age=300
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://inaturalist-open-data.s3.amazonaws.com https://static.inaturalist.org; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
